# ============================================================================
# ContractIQ — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=              # Supabase project URL — Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Supabase anon/public key — Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=             # SERVER ONLY — Project Settings > API. Used by Edge Functions to write extraction/chat results and bypass RLS for system-level inserts. Never expose to the client.

# --- Azure AI Foundry (process-extraction, chat) -----------------------------
AZURE_API_KEY=                         # SERVER ONLY — Azure AI Foundry portal > project > Settings > API keys. Used by process-extraction and chat Edge Functions. Never expose to the client.
AZURE_AGENT_ENDPOINT=                  # SERVER ONLY — Azure AI Foundry portal > project > Agents > your agent > Endpoint field. Use the agent-scoped endpoint (contains /agents/<agent-name>/endpoint/protocols/openai/responses), NOT the generic project-level /openai/v1/responses URL — only the agent-scoped endpoint produces traces in the Foundry portal.
MAX_CHAT_HISTORY=200                   # SERVER ONLY (optional) — max prior chat_messages rows fetched per turn in the chat Edge Function. Defaults to 200 if unset.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=                  # Full deployed URL, e.g. https://contractiq.vercel.app (http://localhost:3000 in dev). Used as the redirect target for Supabase Auth email confirmation links.
